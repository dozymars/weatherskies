{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_forecast_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_emails": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDailyForecastEmails"
          },
          "then": "end",
          "x-base44": {
            "title": "Send forecast emails",
            "description": "6 AM daily digest for saved locations"
          }
        }
      }
    ]
  },
  "description": "Every morning at 6 AM, emails logged-in users a forecast summary for each of their saved locations",
  "name": "Daily Forecast Email"
}